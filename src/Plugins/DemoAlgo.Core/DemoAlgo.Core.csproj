<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DemoAlgo.Core</RootNamespace>
    <Version>1.0.0</Version>
    <!-- 纯算法库：不依赖 UI 框架（通过 ComUI.Sdk 的载荷类型与宿主交换数据） -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ComUI.Sdk\ComUI.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 算法 JSON 描述文件：随 DLL 一起复制 -->
    <None Include="demo.algo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="demo.node.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 编译完成后把「算法DLL + JSON」复制到 comdll/algo/DemoStitching -->
  <Target Name="CopyToComdll" AfterTargets="Build">
    <ItemGroup>
      <_PluginOutputs Include="$(OutDir)*.*" Exclude="$(OutDir)ComUI.Sdk.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginOutputs)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\comdll\algo\DemoStitching\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
