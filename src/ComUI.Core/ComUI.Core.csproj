<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ComUI.Core</RootNamespace>
    <Version>0.1.0</Version>
    <Description>ComUI 引擎层：插件加载/隔离、数据总线、日志、声明式导入、配置（UI 层 ComUI.Host 引用本库）</Description>
