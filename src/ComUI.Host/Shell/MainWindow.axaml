<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ComUI.Host.Shell.MainWindow"
        Title="ComUI 显示平台 v0.3"
        Width="1500" Height="880"
        MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E20"
        Foreground="#E8E8EA"
        FontFamily="Microsoft YaHei UI, Segoe UI, Noto Sans CJK SC, WenQuanYi Micro Hei, Ubuntu, sans-serif"
        FontSize="13">

    <!-- 手写确定性布局：活动栏 / 侧边栏 / 标签页 / 属性 / 日志，全部宿主自有，无第三方停靠库 -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- 菜单栏 -->
        <Menu>
            <MenuItem Header="文件">
                <MenuItem Header="重新加载插件" InputGesture="F5" Click="ReloadPlugins_Click"/>
                <MenuItem Header="打开插件目录" Click="OpenPluginDir_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="打开全部面板" Click="OpenAll_Click"/>
                <MenuItem Header="关闭所有面板" Click="CloseAllTabs_Click"/>
                <MenuItem Header="默认布局" Click="ResetLayout_Click"/>
                <MenuItem Header="欢迎页" Click="Welcome_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPanel" Header="面板侧边栏" Click="TogglePanelMenu_Click"/>
                <MenuItem x:Name="MenuProps" Header="属性面板" Click="TogglePropsMenu_Click"/>
                <MenuItem x:Name="MenuLog" Header="日志面板" Click="ToggleLogMenu_Click"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于 ComUI" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="#232326" BorderBrush="#313135"
                BorderThickness="0,0,0,1" Padding="10,7">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="⟳ 重新加载插件" Click="ReloadPlugins_Click" ToolTip.Tip="重新扫描 comdll 并加载 (F5)"/>
                <Button Classes="ghost" Content="📂 插件目录" Click="OpenPluginDir_Click"/>
            </StackPanel>
        </Border>

        <!-- 主区：活动栏 / 侧边栏 / 标签页与日志 / 属性 -->
        <Grid Grid.Row="2" x:Name="MainGrid" ColumnDefinitions="46,235,4,*,4,255">
            <!-- 活动栏（图标开关，代码生成） -->
            <StackPanel x:Name="ActivityBar" Background="#1C1C1F"/>
            <!-- 侧边栏内容（随活动栏图标切换） -->
            <ContentControl x:Name="SidebarContent" Grid.Column="1"/>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Width="4"/>
            <!-- 中间：标签页 + 底部日志 -->
            <Grid Grid.Column="3" x:Name="CenterGrid" RowDefinitions="*,4,200">
                <Grid x:Name="SplitHost" Background="#1E1E20"/>
                <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="4"/>
                <ContentControl x:Name="LogHost" Grid.Row="2"/>
            </Grid>
            <GridSplitter x:Name="PropsSplitter" Grid.Column="4" Width="4"/>
            <!-- 右侧属性 -->
            <ContentControl x:Name="PropsHost" Grid.Column="5"/>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#232326" BorderBrush="#313135"
                BorderThickness="0,1,0,0" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="#9D9D9D"/>
                <TextBlock x:Name="BusyText" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="12" Foreground="#4FC1FF" IsVisible="False"/>
                <Button x:Name="CancelRunBtn" Grid.Column="2" Classes="ghost" Content="取消"
                        IsVisible="False" Click="CancelRun_Click" MinHeight="22" Padding="10,1"/>
                <TextBlock x:Name="PluginCountText" Grid.Column="3" VerticalAlignment="Center"
                           FontSize="12" Foreground="#9D9D9D"/>
            </Grid>
        </Border>
    </Grid>
</Window>
