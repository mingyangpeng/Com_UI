{
  "node": {
    "id": "alg.image2d.contour_cloud",
    "name": "轮廓点云",
    "group": "2D 图像",
    "category": "处理",
    "description": "轮廓原始点集导出为 z=0 点云（宿主 3D 工作台查看轮廓）"
  },
  "runtime": "native",
  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiContourCloud",
  "inputs": [
    {
      "name": "输入",
      "type": "image"
    }
  ],
  "params": [
    {
      "name": "external_only",
      "label": "只取外轮廓",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "1=只取最外层轮廓"
    },
    {
      "name": "min_area",
      "label": "最小面积",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 10000000,
      "description": "面积过滤（像素²）"
    }
  ],
  "outputs": [
    {
      "name": "点云",
      "type": "cloud"
    }
  ],
