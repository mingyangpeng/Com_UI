{
  "node": {
    "id": "alg.image2d.approx_poly_dp",
    "name": "多边形顶点逼近",
    "group": "2D 图像",
    "category": "处理",
    "description": "Douglas-Peucker 轮廓顶点逼近（epsilon 像素容差）：输出多边形顶点点集(z=0)，形状判定前置（如矩形轮廓→4 角点）；输入点集可来自 contour_cloud 等节点"
  },
  "runtime": "native",
  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiApproxPolyDP",
  "inputs": [
    {
      "name": "轮廓点集",
      "type": "cloud"
    }
  ],
  "params": [
    {
      "name": "epsilon",
      "label": "逼近容差(像素)",
      "type": "number",
      "default": 3,
      "min": 0,
      "max": 10000,
      "description": "Douglas-Peucker 容差（0=仅去除共线冗余；过大会退化到 <3 顶点）"
    },
    {
      "name": "closed",
      "label": "闭合轮廓",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "1=闭合轮廓（findContours 输出）"
    }
  ],
  "outputs": [
    {
      "name": "多边形点集",
      "type": "cloud"
    }
  ],
  "source": {
    "files": [
      "integration/comui/Image2DAlg_comui.cpp",
      "integration/comui/comui_native_abi.h",
      "src/AlgExport.h",
      "src/Image2DAlg/Image2DAlg_api.cpp",
      "src/Image2DAlg/Image2DAlg_Ops.cpp",
      "src/Image2DAlg/include/Image2DAlg_api.h"
    ],
    "includes": [
      "src",
      "src/Image2DAlg/include"
    ]
  }
}
