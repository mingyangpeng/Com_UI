{
  "node": {
    "id": "alg.image2d.hough_lines_proi",
    "name": "霍夫直线ROI",
    "group": "2D 图像",
    "category": "处理",
    "description": "概率霍夫直线检测 ROI 版：仅在 ROI 内检测（线段端点平移回全图坐标系），roi_w/roi_h ≤0 = 全图；限区检测省时并屏蔽区外干扰；与 hough_lines（全图版）的分工：输入/参数语义相同，本节点多 roi_x/y/w/h 四个 ROI 参数；消息含端点与角度（票数 C API 不回传）"
  },
  "runtime": "native",
  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiHoughLinesPRoi",
  "inputs": [
    {
      "name": "输入",
      "type": "image"
    }
  ],
  "params": [
    {
      "name": "roi_x",
      "label": "ROI X",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 100000,
      "description": "ROI 左上角 X"
    },
    {
      "name": "roi_y",
      "label": "ROI Y",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 100000,
      "description": "ROI 左上角 Y"
    },
    {
      "name": "roi_w",
      "label": "ROI 宽(0全图)",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 100000,
      "description": "ROI 宽（<=0 = 全图，同 connected_components_roi）"
    },
    {
      "name": "roi_h",
      "label": "ROI 高(0全图)",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 100000,
      "description": "ROI 高（<=0 = 全图）"
    },
    {
      "name": "rho",
      "label": "距离分辨率",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 10,
      "description": "距离分辨率（像素）"
    },
    {
      "name": "theta_deg",
      "label": "角度分辨率(度)",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 10,
      "description": "角度分辨率（度）"
    },
    {
      "name": "threshold",
      "label": "投票阈值",
      "type": "int",
      "default": 50,
      "min": 1,
      "max": 10000,
      "description": "投票阈值"
    },
    {
      "name": "min_line_length",
      "label": "最短线长(0不限)",
      "type": "int",
      "default": 20,
      "min": 0,
      "max": 10000,
      "description": "最短线长（0 不限）"
    },
    {
      "name": "max_line_gap",
      "label": "最大断距(0不限)",
      "type": "int",
      "default": 5,
      "min": 0,
      "max": 10000,
      "description": "线最大断距（0 不限）"
    }
  ],
  "outputs": [
    {
      "name": "输出",
      "type": "image"
    }
  ],
  "source": {
    "files": [
      "integration/comui/Image2DAlg_comui.cpp",
      "integration/comui/comui_native_abi.h",
      "src/AlgExport.h",
      "src/Image2DAlg/Image2DAlg_api.cpp",
      "src/Image2DAlg/Image2DAlg_Ops.cpp",
      "src/Image2DAlg/include/Image2DAlg_api.h"
    ],
    "includes": [
      "src",
      "src/Image2DAlg/include"
    ]
  }
}
