{
  "node": {
    "id": "alg.image2d.match_template_ex",
    "name": "Mark 点对位",
    "group": "2D 图像",
    "category": "处理",
    "description": "多尺度×多角度模板匹配对位：输出中心十字标注，score/中心/尺度/角度并入节点消息"
  },
  "runtime": "native",
  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiMatchTemplateEx",
  "inputs": [
    {
      "name": "搜索图",
      "type": "image"
    },
    {
      "name": "模板",
      "type": "image"
    }
  ],
  "params": [
    {
      "name": "method",
      "label": "匹配方法",
      "type": "int",
      "default": 5,
      "min": 0,
      "max": 5,
      "description": "cv::TemplateMatchModes（默认 5=CCOEFF_NORMED 归一化相关）"
    },
    {
      "name": "scale_lo",
      "label": "尺度下限",
      "type": "number",
      "default": 0.8,
      "min": 0.01,
      "max": 10,
      "description": "尺度搜索下限"
    },
    {
      "name": "scale_hi",
      "label": "尺度上限",
      "type": "number",
      "default": 1.2,
      "min": 0.01,
      "max": 10,
      "description": "尺度搜索上限"
    },
    {
      "name": "scale_step",
      "label": "尺度步进",
      "type": "number",
      "default": 0.05,
      "min": 0.001,
      "max": 10,
      "description": "尺度步距"
    },
    {
      "name": "angle_lo",
      "label": "角度下限(度)",
      "type": "number",
      "default": -15,
      "min": -360,
      "max": 360,
      "description": "角度搜索下限（度，逆时针）"
    },
    {
      "name": "angle_hi",
      "label": "角度上限(度)",
      "type": "number",
      "default": 15,
      "min": -360,
      "max": 360,
      "description": "角度搜索上限（度）"
    },
    {
      "name": "angle_step",
      "label": "角度步进(度)",
      "type": "number",
      "default": 1,
      "min": 0.01,
      "max": 90,
      "description": "角度步距（度）"
    }
  ],
  "outputs": [
    {
      "name": "输出",
      "type": "image"
    }
  ],
  "source": {
    "files": [
      "integration/comui/Image2DAlg_comui.cpp",
      "integration/comui/comui_native_abi.h",
      "src/AlgExport.h",
      "src/Image2DAlg/Image2DAlg_api.cpp",
      "src/Image2DAlg/Image2DAlg_Ops.cpp",
      "src/Image2DAlg/include/Image2DAlg_api.h"
    ],
    "includes": [
      "src",
      "src/Image2DAlg/include"
    ]
  }
}
