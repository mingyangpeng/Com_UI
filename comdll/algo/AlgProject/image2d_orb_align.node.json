{
  "node": {
    "id": "alg.image2d.orb_align",
    "name": "ORB 特征对位",
    "group": "2D 图像",
    "category": "处理",
    "description": "ORB 特征匹配 + RANSAC 仿射对位（大形变/旋转/亮度鲁棒）：输出匹配点十字标注，仿射矩阵/内点数并入节点消息"
  },
  "runtime": "native",
  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiORBAlign",
  "inputs": [
    {
      "name": "基准图",
      "type": "image"
    },
    {
      "name": "待对位图",
      "type": "image"
    }
  ],
  "params": [
    {
      "name": "n_features",
      "label": "特征点上限",
      "type": "int",
      "default": 500,
      "min": 50,
      "max": 2000,
      "description": "ORB 特征点数量上限（越大匹配越稳、越慢）"
    },
    {
      "name": "ratio",
      "label": "Lowe比率",
      "type": "number",
      "default": 0.7,
      "min": 0.1,
      "max": 0.9,
      "description": "Lowe 比率测试阈值（越大匹配越多、误配也随之增多）"
    }
  ],
  "outputs": [
    {
      "name": "输出",
      "type": "image"
    }
  ],
  "source": {
    "files": [
      "integration/comui/Image2DAlg_comui.cpp",
      "integration/comui/comui_native_abi.h",
      "src/AlgExport.h",
      "src/Image2DAlg/Image2DAlg_api.cpp",
      "src/Image2DAlg/Image2DAlg_Ops.cpp",
      "src/Image2DAlg/include/Image2DAlg_api.h"
    ],
    "includes": [
      "src",
      "src/Image2DAlg/include"
    ]
  }
}
