      "default": -5,
      "min": -360,
      "max": 360,
      "description": "角度搜索下限（度）"
    },
    {
      "name": "angle_hi",
      "label": "角度上限(度)",
      "type": "number",
      "default": 5,
      "min": -360,
      "max": 360,
      "description": "角度搜索上限（度）"
    },
    {
      "name": "angle_step",
      "label": "角度步进(度)",
      "type": "number",
      "default": 1,
      "min": 0.01,
      "max": 90,
      "description": "角度步距（度）"
    }
