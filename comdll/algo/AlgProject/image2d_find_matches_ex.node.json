{
  "node": {
    "id": "alg.image2d.find_matches_ex",
    "name": "Mark 阵列全检",
    "group": "2D 图像",
    "category": "处理",
    "description": "多目标×旋转×尺度组合模板匹配（Mark 阵列全检，全局 NMS）：输出中心十字标注，位置/尺度/角度/得分并入节点消息"
  },
  "runtime": "native",
  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiFindMatchesEx",
  "inputs": [
    {
      "name": "搜索图",
      "type": "image"
    },
    {
      "name": "模板",
      "type": "image"
    }
  ],
  "params": [
    {
      "name": "method",
      "label": "匹配方法",
      "type": "int",
      "default": 5,
      "min": 0,
      "max": 5,
      "description": "cv::TemplateMatchModes（默认 5=归一化相关）"
    },
    {
      "name": "score_threshold",
      "label": "得分阈值",
      "type": "number",
