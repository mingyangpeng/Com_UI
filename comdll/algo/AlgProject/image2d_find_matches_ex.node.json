      "label": "NMS 半径",
      "type": "int",
      "default": 10,
      "min": 0,
      "max": 200,
      "description": "全局 NMS 半径（模板中心距，像素）"
    },
    {
      "name": "scale_lo",
      "label": "尺度下限",
      "type": "number",
      "default": 0.9,
      "min": 0.01,
      "max": 10,
      "description": "尺度搜索下限"
    },
    {
      "name": "scale_hi",
      "label": "尺度上限",
      "type": "number",
      "default": 1.1,
      "min": 0.01,
      "max": 10,
      "description": "尺度搜索上限"
    },
    {
      "name": "scale_step",
