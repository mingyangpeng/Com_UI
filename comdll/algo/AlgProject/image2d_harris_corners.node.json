{
  "node": {
    "id": "alg.image2d.harris_corners",
    "name": "Harris 角点",
    "group": "2D 图像",
    "category": "处理",
    "description": "Harris 角点检测（Mark 点自动定位）：输出角点十字标注，坐标并入节点消息"
  },
  "runtime": "native",
  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiHarrisCorners",
  "inputs": [
    {
      "name": "输入",
      "type": "image"
    }
  ],
  "params": [
    {
      "name": "block_size",
      "label": "邻域窗口",
      "type": "int",
      "default": 5,
      "min": 3,
      "max": 51,
      "description": "角点检测邻域窗口（奇数自动补）"
    },
    {
      "name": "ksize",
      "label": "Sobel核",
      "type": "int",
      "default": 3,
      "min": 3,
      "max": 7,
      "description": "Sobel 梯度核边长（3~7）"
    },
    {
      "name": "k",
