      "min": 0,
      "max": 1,
      "description": "响应阈值比例（相对最大响应，越小角点越多）"
    },
    {
      "name": "subpix",
      "label": "亚像素细化",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "1=角点亚像素细化"
    }
  ],
  "outputs": [
    {
      "name": "输出",
      "type": "image"
    }
  ],
