      "type": "number",
      "default": 0.04,
      "min": 0.01,
      "max": 0.1,
      "description": "Harris 响应常数（经验 0.04~0.06）"
    },
    {
      "name": "thresh_ratio",
      "label": "响应阈值比例",
      "type": "number",
