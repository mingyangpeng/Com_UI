    {
      "name": "nms_radius",
      "label": "NMS 半径",
      "type": "int",
      "default": 5,
      "min": 0,
      "max": 100,
      "description": "非极大值抑制半径（像素）"
    }
  ],
  "outputs": [
    {
      "name": "输出",
      "type": "image"
    }
  ],
