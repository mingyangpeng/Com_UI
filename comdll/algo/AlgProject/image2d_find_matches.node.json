{
  "node": {
    "id": "alg.image2d.find_matches",
    "name": "多目标匹配",
    "group": "2D 图像",
    "category": "处理",
    "description": "多目标模板匹配（NMS 去重）：输出命中外框标注，位置/得分并入节点消息"
  },
  "runtime": "native",
  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiFindMatches",
  "inputs": [
    {
      "name": "搜索图",
      "type": "image"
    },
    {
      "name": "模板",
      "type": "image"
    }
  ],
  "params": [
    {
      "name": "method",
      "label": "匹配方法",
      "type": "int",
      "default": 5,
      "min": 0,
      "max": 5,
      "description": "cv::TemplateMatchModes（默认 5=归一化相关）"
    },
    {
      "name": "score_threshold",
      "label": "得分阈值",
      "type": "number",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "description": "得分阈值（SQDIFF 系=得分≤阈值命中，其余=≥）"
